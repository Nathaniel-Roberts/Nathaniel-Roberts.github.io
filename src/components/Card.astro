---
import { fmtDateShort, isoDate } from '../site';
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  type?: string;
  tags?: string[];
  minutes?: number;
}
const { href, title, description, date, type, tags = [], minutes } = Astro.props;
const filterKeys = [type?.toLowerCase(), ...tags].filter(Boolean).join(' ');
---

<li class="row" data-tags={filterKeys}>
  <time class="row-date" datetime={isoDate(date)}>{fmtDateShort(date)}</time>
  <div>
    <h3 class="row-title" transition:name={`title-${href}`}><a href={href}>{title}</a></h3>
    <p class="row-desc">{description}</p>
    {(type || tags.length > 0) && (
      <p class="row-meta">
        {type && <span class="row-type">{type}</span>}
        {tags.map((t) => <span>{t.replace(/-/g, ' ')}</span>)}
      </p>
    )}
  </div>
  {minutes && <span class="row-time">{minutes} min</span>}
</li>
