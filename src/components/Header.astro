---
import { SITE } from '../site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <span class="brand-long">nathanielroberts<span class="dot">.</span>tech</span>
      <span class="brand-short">nr<span class="dot">.</span>tech</span>
    </a>
    <nav class="nav" aria-label="Main">
      {SITE.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="search-btn" type="button" data-search-open aria-label="Search the site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="search-label">Search</span>
        <kbd data-kbd>Ctrl K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const update = () => {
    const header = document.querySelector('[data-header]');
    if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', update, { passive: true });
  document.addEventListener('astro:page-load', () => {
    update();
    const kbd = document.querySelector('[data-kbd]');
    if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';
  });
</script>
