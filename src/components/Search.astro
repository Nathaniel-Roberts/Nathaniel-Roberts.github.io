<dialog class="palette" data-palette aria-label="Search">
  <div class="palette-box">
    <div class="palette-input">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Search, or type > for commands" aria-label="Search" autocomplete="off" spellcheck="false" data-palette-input />
    </div>
    <div class="palette-status" data-palette-status></div>
    <ul class="palette-results" data-palette-results role="listbox"></ul>
    <div class="palette-foot">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';

  type Sub = { title: string; url: string; excerpt: string };
  type PF = { init: () => void; options: (o: unknown) => Promise<void>; debouncedSearch: (q: string) => Promise<{ results: { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string; sub_results?: Sub[] }> }[] } | null> };

  type Action = { label: string; hint: string; run: () => void };
  const clean = (u: string) => u.replace(/\/index\.html(#|$)/, '/$1');
  function actions(): Action[] {
    const w = window as any;
    const themes: string[] = w.siteThemes || [];
    const go = (href: string) => () => navigate(href);
    return [
      { label: 'Go to Home', hint: 'g h', run: go('/') },
      { label: 'Go to Blog', hint: 'g b', run: go('/posts/') },
      { label: 'Go to Projects', hint: 'g p', run: go('/projects/') },
      { label: 'Go to Uses', hint: 'g u', run: go('/uses/') },
      { label: 'Go to About', hint: 'g a', run: go('/about/') },
      { label: 'Go to Contact', hint: 'g c', run: go('/contact/') },
      { label: 'Copy email address', hint: 'contact@nathanielroberts.tech', run: () => { navigator.clipboard?.writeText('contact@nathanielroberts.tech'); } },
      { label: 'Open RSS feed', hint: '/rss.xml', run: () => { location.href = '/rss.xml'; } },
      { label: 'Keyboard shortcuts', hint: '?', run: () => document.dispatchEvent(new KeyboardEvent('keydown', { key: '?' })) },
      ...themes.map((t) => ({ label: `Theme: ${t}`, hint: 'theme', run: () => w.setSiteTheme?.(t) })),
    ];
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  let pagefind: PF | null = null;
  let pendingActions: Action[] = [];
  let loadFailed = false;

  async function load(): Promise<PF | null> {
    if (pagefind || loadFailed) return pagefind;
    try {
      // @ts-expect-error generated by Pagefind at build time, not a source module
      pagefind = (await import(/* @vite-ignore */ '/pagefind/pagefind.js')) as PF;
      await pagefind.options({ excerptLength: 16 });
      pagefind.init();
    } catch {
      loadFailed = true;
    }
    return pagefind;
  }

  const q = <T extends Element>(s: string) => document.querySelector<T>(s);
  const dialog = () => q<HTMLDialogElement>('[data-palette]');

  function open() {
    const d = dialog();
    if (!d || d.open) return;
    d.showModal();
    const input = q<HTMLInputElement>('[data-palette-input]');
    input?.focus();
    input?.select();
    void load();
    void search(input?.value || '');
  }
  function close() { dialog()?.close(); }

  function activate(a: HTMLAnchorElement) {
    const li = a.closest<HTMLElement>('[data-action]');
    close();
    if (li) { pendingActions[Number(li.dataset.action)]?.run(); return; }
    navigate(a.getAttribute('href')!);
  }

  function select(delta: number) {
    const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-palette-results] a')];
    if (!items.length) return;
    const cur = items.findIndex((a) => a.getAttribute('aria-selected') === 'true');
    const next = (cur + delta + items.length) % items.length;
    items.forEach((a, i) => a.setAttribute('aria-selected', String(i === next)));
    items[next].scrollIntoView({ block: 'nearest' });
  }

  async function search(term: string) {
    const results = q<HTMLUListElement>('[data-palette-results]');
    const status = q<HTMLElement>('[data-palette-status]');
    if (!results || !status) return;
    const isCmd = term.startsWith('>');
    const needle = (isCmd ? term.slice(1) : term).trim().toLowerCase();
    const norm = (x: string) => x.toLowerCase().replace(/[^a-z0-9 ]+/g, ' ').replace(/\s+/g, ' ').trim();
    const n = norm(needle);
    const hit = (a: Action) => !n || norm(a.label).includes(n) || norm(a.hint).includes(n);
    const acts = actions().filter((a) => (isCmd || !n ? hit(a) : n.length >= 2 && hit(a))).slice(0, isCmd || !n ? 20 : 3);
    const actHtml = acts.map((a, i) => `<li role="option" data-action="${i}"><a href="#" aria-selected="false"><div class="r-title">${esc(a.label)}</div><div class="r-url">${esc(a.hint)}</div></a></li>`).join('');
    if (isCmd || !needle) { results.innerHTML = actHtml; status.textContent = isCmd && !acts.length ? 'No matching command.' : ''; pendingActions = acts; results.querySelector('a')?.setAttribute('aria-selected', 'true'); return; }
    pendingActions = acts;
    const pf = await load();
    if (!pf) { status.textContent = 'Search index not available yet.'; return; }
    const res = await pf.debouncedSearch(needle);
    if (!res) return;
    const data = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    const pages = data
      .map((d) => {
        const url = clean(d.url);
        const subs = (d.sub_results || []).filter((s) => s.url.includes('#') && s.title !== d.meta.title).slice(0, 2);
        const subHtml = subs.map((s) => `<a class="r-sub" href="${clean(s.url)}" aria-selected="false"><span class="r-sub-title">${esc(s.title)}</span><span class="r-ex">${s.excerpt}</span></a>`).join('');
        return `<li role="option"><a href="${url}" aria-selected="false"><div class="r-title">${esc(d.meta.title ?? url)}</div><div class="r-ex">${d.excerpt}</div><div class="r-url">${url}</div></a>${subHtml}</li>`;
      })
      .join('');
    results.innerHTML = actHtml + pages;
    results.querySelector('a')?.setAttribute('aria-selected', 'true');
    status.textContent = data.length || acts.length ? '' : `No results for "${needle}".`;
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-search-open]')) { open(); return; }
    const d = dialog();
    if (d && d.open && t === d) close();
    const link = t.closest<HTMLAnchorElement>('[data-palette-results] a');
    if (link) { e.preventDefault(); activate(link); }
  });

  document.addEventListener('keydown', (e) => {
    const inField = /^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement).tagName);
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog()?.open ? close() : open(); return; }
    if (e.key === '/' && !inField) { e.preventDefault(); open(); return; }
    const d = dialog();
    if (!d?.open) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); select(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(-1); }
    else if (e.key === 'Enter') {
      const a = q<HTMLAnchorElement>('[data-palette-results] a[aria-selected="true"]');
      if (a) { e.preventDefault(); activate(a); }
    }
  });

  document.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-palette-input]')) void search(t.value);
  });
</script>
