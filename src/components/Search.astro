<dialog class="palette" data-palette aria-label="Search">
  <div class="palette-box">
    <div class="palette-input">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Search posts and projects" aria-label="Search" autocomplete="off" spellcheck="false" data-palette-input />
    </div>
    <div class="palette-status" data-palette-status></div>
    <ul class="palette-results" data-palette-results role="listbox"></ul>
    <div class="palette-foot">
      <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';

  type PF = { init: () => void; options: (o: unknown) => Promise<void>; debouncedSearch: (q: string) => Promise<{ results: { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> }[] } | null> };
  let pagefind: PF | null = null;
  let loadFailed = false;

  async function load(): Promise<PF | null> {
    if (pagefind || loadFailed) return pagefind;
    try {
      // @ts-expect-error generated by Pagefind at build time, not a source module
      pagefind = (await import(/* @vite-ignore */ '/pagefind/pagefind.js')) as PF;
      await pagefind.options({ excerptLength: 22 });
      pagefind.init();
    } catch {
      loadFailed = true;
    }
    return pagefind;
  }

  const q = <T extends Element>(s: string) => document.querySelector<T>(s);
  const dialog = () => q<HTMLDialogElement>('[data-palette]');

  function open() {
    const d = dialog();
    if (!d || d.open) return;
    d.showModal();
    const input = q<HTMLInputElement>('[data-palette-input]');
    input?.focus();
    input?.select();
    void load();
  }
  function close() { dialog()?.close(); }

  function select(delta: number) {
    const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-palette-results] a')];
    if (!items.length) return;
    const cur = items.findIndex((a) => a.getAttribute('aria-selected') === 'true');
    const next = (cur + delta + items.length) % items.length;
    items.forEach((a, i) => a.setAttribute('aria-selected', String(i === next)));
    items[next].scrollIntoView({ block: 'nearest' });
  }

  async function search(term: string) {
    const results = q<HTMLUListElement>('[data-palette-results]');
    const status = q<HTMLElement>('[data-palette-status]');
    if (!results || !status) return;
    if (!term.trim()) { results.innerHTML = ''; status.textContent = ''; return; }
    const pf = await load();
    if (!pf) { status.textContent = 'Search index not available yet.'; return; }
    const res = await pf.debouncedSearch(term);
    if (!res) return;
    const data = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    results.innerHTML = data
      .map((d, i) => {
        const url = d.url.replace(/\/index\.html$/, '/');
        return `<li role="option"><a href="${url}" aria-selected="${i === 0}"><div class="r-title">${d.meta.title ?? url}</div><div class="r-ex">${d.excerpt}</div><div class="r-url">${url}</div></a></li>`;
      })
      .join('');
    status.textContent = data.length ? '' : `No results for "${term}".`;
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-search-open]')) { open(); return; }
    const d = dialog();
    if (d && d.open && t === d) close();
    const link = t.closest<HTMLAnchorElement>('[data-palette-results] a');
    if (link) { e.preventDefault(); close(); navigate(link.getAttribute('href')!); }
  });

  document.addEventListener('keydown', (e) => {
    const inField = /^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement).tagName);
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dialog()?.open ? close() : open(); return; }
    if (e.key === '/' && !inField) { e.preventDefault(); open(); return; }
    const d = dialog();
    if (!d?.open) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); select(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(-1); }
    else if (e.key === 'Enter') {
      const a = q<HTMLAnchorElement>('[data-palette-results] a[aria-selected="true"]');
      if (a) { e.preventDefault(); close(); navigate(a.getAttribute('href')!); }
    }
  });

  document.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-palette-input]')) void search(t.value);
  });
</script>
