---
export const THEMES = [
  { id: 'system', label: 'System' },
  { id: 'light', label: 'Plex Light' },
  { id: 'dark', label: 'Plex Dark' },
  { id: 'latte', label: 'Catppuccin Latte' },
  { id: 'mocha', label: 'Catppuccin Mocha' },
  { id: 'nord', label: 'Nord' },
  { id: 'gruvbox', label: 'Gruvbox Dark' },
  { id: 'rose-pine', label: 'Rosé Pine' },
  { id: 'tokyo-night', label: 'Tokyo Night' },
  { id: 'solarized-light', label: 'Solarized Light' },
  { id: 'solarized-dark', label: 'Solarized Dark' },
];
---

<button class="icon-btn" type="button" data-theme-toggle aria-label="Choose theme" aria-haspopup="menu" aria-expanded="false" title="Theme">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2v-1a2 2 0 0 1 2-2h1a4 4 0 0 0 4-4 9 9 0 0 0-9-9Z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15.5" cy="7.5" r="1"/></svg>
</button>
<div class="theme-menu" data-theme-menu role="menu" aria-label="Theme" hidden>
  {THEMES.map((t, i) => (
    <>
      {i === 1 && <hr />}
      <button type="button" role="menuitemradio" aria-checked="false" data-set-theme={t.id}><span class={`sw sw-${t.id}`}></span>{t.label}</button>
    </>
  ))}
</div>

<script>
  const SCHEME: Record<string, string> = { light: 'light', dark: 'dark', latte: 'light', mocha: 'dark', nord: 'dark', gruvbox: 'dark', 'rose-pine': 'dark', 'tokyo-night': 'dark', 'solarized-light': 'light', 'solarized-dark': 'dark' };
  const menu = () => document.querySelector<HTMLElement>('[data-theme-menu]');
  const toggleBtn = () => document.querySelector<HTMLElement>('[data-theme-toggle]');

  function syncMenu() {
    const choice = document.documentElement.getAttribute('data-theme-choice') || 'system';
    document.querySelectorAll<HTMLElement>('[data-set-theme]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.setTheme === choice)));
  }
  function openMenu(open: boolean) {
    const m = menu(); const b = toggleBtn();
    if (!m || !b) return;
    m.hidden = !open;
    b.setAttribute('aria-expanded', String(open));
    if (open) syncMenu();
  }
  function setTheme(name: string): boolean {
    if (name !== 'system' && !SCHEME[name]) return false;
    const root = document.documentElement;
    root.classList.add('theme-transition');
    try { if (name === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', name); } catch {}
    (window as any).__applyTheme?.();
    window.dispatchEvent(new CustomEvent('themechange', { detail: root.getAttribute('data-theme') }));
    window.setTimeout(() => root.classList.remove('theme-transition'), 350);
    syncMenu();
    return true;
  }
  (window as any).setSiteTheme = setTheme;
  (window as any).siteThemes = ['system', ...Object.keys(SCHEME)];

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-theme-toggle]')) { openMenu(menu()?.hidden !== false); return; }
    const item = t.closest<HTMLElement>('[data-set-theme]');
    if (item) { setTheme(item.dataset.setTheme!); openMenu(false); return; }
    if (!t.closest('[data-theme-menu]')) openMenu(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu() && !menu()!.hidden) openMenu(false); });
  document.addEventListener('astro:page-load', () => openMenu(false));
</script>
