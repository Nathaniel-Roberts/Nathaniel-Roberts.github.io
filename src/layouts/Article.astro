---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import Card from '../components/Card.astro';
import { SITE, fmtDate, isoDate } from '../site';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  type?: string;
  minutes: number;
  words: number;
  headings: MarkdownHeading[];
  og: string;
  comments?: boolean;
  back: { href: string; label: string };
  sourcePath: string;
  related?: { href: string; title: string; description: string; date: Date; type?: string; tags: string[] }[];
}
const { title, description, date, updated, tags, type, minutes, words, headings, og, comments = false, back, sourcePath, related = [] } = Astro.props;
const permalink = Astro.url.pathname;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': type ? 'Report' : 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
  image: new URL(`/og/${og}.png`, SITE.url).toString(),
  mainEntityOfPage: new URL(permalink, SITE.url).toString(),
  keywords: tags.join(', '),
  wordCount: words,
  inLanguage: 'en-AU',
};
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 3;
const editUrl = `${SITE.repo}/blob/main/${sourcePath}`;
---

<Base title={title} description={description} og={og} type="article" published={date} jsonld={jsonld}>
  <div class="progress" data-progress aria-hidden="true"></div>
  <div class={`article ${hasToc ? 'has-toc' : ''}`}>
    <div>
      <header class="article-head">
        <a class="back" href={back.href}>../{back.label}</a>
        <h1 transition:name={`title-${permalink}`}>{title}</h1>
        <p class="lede">{description}</p>
        <p class="art-meta">
          {type && <span class="type">{type}</span>}
          <time datetime={isoDate(date)}>{fmtDate(date)}</time>
          <span>{minutes} min read</span>
          {updated && <span>updated {fmtDate(updated)}</span>}
        </p>
        {tags.length > 0 && (
          <p class="art-tags">
            {tags.map((t) => <a href={`${back.href}?tag=${encodeURIComponent(t)}`}>#{t}</a>)}
          </p>
        )}
      </header>

      {hasToc && (
        <details class="toc-mobile">
          <summary>Contents</summary>
          <Toc headings={tocHeadings} />
        </details>
      )}

      <div class="resume" data-resume hidden>
        <span>You were part way through this. <span data-resume-label></span></span>
        <button type="button" data-resume-go>Continue</button>
        <button type="button" data-resume-dismiss>Start from the top</button>
      </div>

      <div class="prose" data-prose data-pagefind-body>
        <slot />
      </div>

      <footer class="article-foot">
        <a href={back.href}>Back to {back.label}</a>
        <button type="button" class="linkish" data-print>Print or save as PDF</button>
        <a href={editUrl} target="_blank" rel="noopener">View source on GitHub</a>
      </footer>

      {related.length > 0 && (
        <section class="section related" aria-label="Related">
          <div class="section-head"><h2>Related</h2></div>
          <ol class="index">
            {related.map((r) => <Card href={r.href} title={r.title} description={r.description} date={r.date} type={r.type} tags={r.tags} />)}
          </ol>
        </section>
      )}

      {comments && <Giscus />}
    </div>
    {hasToc && (
      <aside class="toc-side">
        <Toc headings={tocHeadings} />
      </aside>
    )}
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Image preview">
    <img alt="" />
  </dialog>
</Base>

<script>
  let observer: IntersectionObserver | null = null;

  function progress() {
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    if (!bar) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  }

  function spy() {
    observer?.disconnect();
    const prose = document.querySelector('[data-prose]');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')];
    if (!prose || !links.length) return;
    const setCurrent = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${id}`)));
    const heads = [...prose.querySelectorAll<HTMLElement>('h2[id], h3[id]')];
    observer = new IntersectionObserver((entries) => {
      const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (hit) setCurrent(hit.target.id);
    }, { rootMargin: '-72px 0px -65% 0px', threshold: 0 });
    heads.forEach((h) => observer!.observe(h));
    if (heads[0]) setCurrent(heads[0].id);
  }

  function copyButtons() {
    document.querySelectorAll<HTMLPreElement>('[data-prose] pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.replaceWith(wrap);
      wrap.appendChild(pre);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.innerText); btn.textContent = 'Copied'; } catch { btn.textContent = 'Failed'; }
        setTimeout(() => (btn.textContent = 'Copy'), 1500);
      });
      wrap.appendChild(btn);
    });
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!box) return;
    const img = t.closest<HTMLImageElement>('[data-prose] img[data-zoom]');
    if (img) {
      const view = box.querySelector('img')!;
      view.src = img.currentSrc || img.src;
      view.alt = img.alt;
      box.showModal();
      return;
    }
    if (box.open && (t === box || t.closest('[data-lightbox]'))) box.close();
  });

  // Resume reading: remember how far down a long page the reader got.
  const key = () => 'read:' + location.pathname;
  let saveTimer = 0;
  function saveProgress() {
    if (!document.querySelector('[data-prose]')) return;
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - innerHeight;
      const ratio = max > 0 ? scrollY / max : 0;
      try {
        if (scrollY < 600 || ratio > 0.95) { localStorage.removeItem(key()); return; }
        const heads = [...document.querySelectorAll<HTMLElement>('[data-prose] h2[id], [data-prose] h3[id]')];
        const current = heads.filter((h) => h.getBoundingClientRect().top < 120).pop();
        localStorage.setItem(key(), JSON.stringify({ y: scrollY, label: current?.textContent?.replace(/#$/, '').trim() || '', t: Date.now() }));
      } catch {}
    }, 400);
  }
  function offerResume() {
    const box = document.querySelector<HTMLElement>('[data-resume]');
    if (!box || scrollY > 100 || location.hash) return;
    let saved: { y: number; label: string } | null = null;
    try { saved = JSON.parse(localStorage.getItem(key()) || 'null'); } catch {}
    if (!saved || saved.y < 600) return;
    const label = box.querySelector('[data-resume-label]');
    if (label) label.textContent = saved.label ? `Last stop: ${saved.label}.` : '';
    box.hidden = false;
    // If the browser restored the scroll position itself (reload), the offer is redundant.
    window.setTimeout(() => { if (scrollY > 300) box.hidden = true; }, 350);
    box.querySelector('[data-resume-go]')?.addEventListener('click', () => { box.hidden = true; window.scrollTo({ top: saved!.y, behavior: 'smooth' }); }, { once: true });
    box.querySelector('[data-resume-dismiss]')?.addEventListener('click', () => { box.hidden = true; try { localStorage.removeItem(key()); } catch {} }, { once: true });
  }

  document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-print]')) window.print(); });
  window.addEventListener('scroll', () => { progress(); saveProgress(); }, { passive: true });
  document.addEventListener('astro:page-load', () => { progress(); spy(); copyButtons(); offerResume(); });
</script>
