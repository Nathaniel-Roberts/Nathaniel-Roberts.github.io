---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, ROLE, STARTED_NEXT, NEXT_ROLE_STARTS, fmtDate } from '../site';
import avatar from '../assets/avatar.jpg';

const description = STARTED_NEXT
  ? 'Cybersecurity incident response analyst at PepsiCo with a systems engineering background.'
  : 'Systems engineer with a cybersecurity background, moving into incident response at PepsiCo.';

const pepsico = {
  when: STARTED_NEXT ? 'Now' : 'Oct 2026',
  title: 'Cybersecurity Incident Response Analyst, PepsiCo',
  body: STARTED_NEXT
    ? 'Incident detection, triage and response across a global enterprise environment.'
    : `Starting ${fmtDate(NEXT_ROLE_STARTS)}. Incident detection, triage and response across a global enterprise environment.`,
};
const sysEng = {
  when: STARTED_NEXT ? '2024 to 2026' : 'Now',
  title: 'ICT Systems Engineer',
  body: 'Building, supporting and optimising IT infrastructure, with automation and security as the default rather than the add-on.',
};

const timeline = [
  pepsico,
  sysEng,
  { when: '2024', title: 'Graduated in Cybersecurity, Macquarie University', body: 'Coursework included the Sony information security review, the GlobalHealth Solutions incident report and the Fortinet privacy impact assessment published under projects.' },
  { when: 'Jun 2024', title: 'Penetration testing internship, WebSchool.au', body: 'Facilitated by SETUP International and Macquarie University. Live-environment testing with Kali Linux, reported back to the client.' },
  { when: 'Sep to Oct 2023', title: 'Capture the Flag engagements', body: 'Two team penetration tests written up as full reports, from reconnaissance through exploitation to remediation advice.' },
];

const skills = [
  { group: 'Operations', items: ['Systems engineering', 'Automation and scripting', 'Infrastructure support', 'IT operations'] },
  { group: 'Defensive security', items: ['Incident response', 'Detection and triage', 'Incident analysis'] },
  { group: 'Offensive security', items: ['Penetration testing', 'Nmap', 'Gobuster and Dirb', 'Burp Suite', 'sqlmap', 'Kali Linux'] },
  { group: 'Governance and risk', items: ['NIST CSF', 'Essential Eight', 'ISO 27001', 'GDPR and the APPs', 'Privacy impact assessment'] },
  { group: 'Data', items: ['Python', 'pandas', 'Jupyter', 'Linear regression'] },
];
---

<Base title="About" description={description} og="about">
  <header class="page-head">
    <p class="eyebrow">~/about</p>
    <h1>About</h1>
  </header>

  <div class="about-grid">
    <div>
      <div class="about-intro">
        <Image class="avatar" src={avatar} alt={`Photo of ${SITE.name}`} width="192" height="192" densities={[1, 2]} />
        <div>
          <p>{ROLE.intro}</p>
          <p>I studied cybersecurity at Macquarie University. The reports on this site came out of that time: penetration tests against live targets, an incident analysis of a healthcare ransomware attack, an information security review for Sony, and a privacy impact assessment of the Fortinet breach. They're here because they show how I think, not just what I know.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/projects/">See the work</a>
            <a class="btn" href="/contact/">Get in touch</a>
            {SITE.cv && <a class="btn" href={SITE.cv} download>Download CV</a>}
          </div>
        </div>
      </div>

      <section class="section">
        <div class="section-head"><h2>Timeline</h2></div>
        <ol class="timeline">
          {timeline.map((t) => (
            <li>
              <span class="when">{t.when}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside>
      <div class="now">
        <p class="eyebrow">Now</p>
        <p>{ROLE.now}</p>
      </div>

      <section class="section">
        <div class="section-head"><h2>Skills</h2></div>
        <dl class="skills">
          {skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>
    </aside>
  </div>
</Base>
