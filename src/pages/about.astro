---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, ROLE, STARTED_NEXT } from '../site';
import avatar from '../assets/avatar.jpg';
import Contributions from '../components/Contributions.astro';

const description = STARTED_NEXT
  ? 'Cybersecurity Incident Response Analyst at PepsiCo with a systems engineering background.'
  : 'Systems engineer with a cybersecurity degree, moving into incident response at PepsiCo in October 2026.';

const experience = [
  {
    when: STARTED_NEXT ? 'Oct 2026 to now' : 'From Oct 2026',
    title: 'Cybersecurity Incident Response Analyst',
    org: 'PepsiCo',
    body: 'Incident detection, triage and response across a global enterprise environment.',
  },
  {
    when: STARTED_NEXT ? '2024 to 2026' : '2024 to now',
    title: 'ICT Systems Engineer',
    org: '',
    body: 'Building, supporting and optimising IT infrastructure. Automation and security as the default, not the add-on.',
  },
  {
    when: 'Jun 2024',
    title: 'Penetration testing intern',
    org: 'WebSchool.au, via SETUP International and Macquarie University',
    body: 'Tested live systems with Kali Linux and reported findings back to the client.',
  },
];

const education = [
  { when: '2024', title: 'Cybersecurity, Macquarie University', body: 'Coursework included penetration testing, incident analysis, privacy assessment and data science.' },
];

const work = [
  { text: 'Designed and built a segmented home network: OPNsense firewall, a VLAN per device class, Terraform-managed configuration, monitoring, and backups that have been tested by restoring them.', href: '/uses/', label: 'See the setup' },
  { text: 'Penetration-tested live systems for a real client during the WebSchool.au internship and delivered the findings.', href: '/posts/webschoolau-internship/', label: 'Read the write-up' },
  { text: 'Wrote a full incident report on a healthcare ransomware attack, assessed against the NIST Cybersecurity Framework, with prioritised recommendations.', href: '/projects/globalhealth-solutions-incident-report/', label: 'Read the report' },
  { text: 'Assessed the privacy impact of the Fortinet breach against the GDPR and the Australian Privacy Principles.', href: '/projects/fortinet-privacy-impact-assessment/', label: 'Read the assessment' },
  { text: 'Completed two capture-the-flag penetration tests and wrote them up as complete reports, from reconnaissance to remediation.', href: '/projects/ctf-two/', label: 'Read a report' },
];

const skills = [
  { group: 'Operations', items: ['Systems engineering', 'Automation and scripting', 'Infrastructure support', 'IT operations'] },
  { group: 'Defensive security', items: ['Incident response', 'Detection and triage', 'Incident analysis'] },
  { group: 'Offensive security', items: ['Penetration testing', 'Nmap', 'Gobuster and Dirb', 'Burp Suite', 'sqlmap', 'Kali Linux'] },
  { group: 'Governance and risk', items: ['NIST CSF', 'Essential Eight', 'ISO 27001', 'GDPR and the APPs', 'Privacy impact assessment'] },
  { group: 'Infrastructure as code', items: ['Terraform', 'Nix and NixOS', 'Git', 'Cloudflare', 'Tailscale'] },
  { group: 'Data', items: ['Python', 'pandas', 'Jupyter', 'Linear regression'] },
];
---

<Base title="About" description={description} og="about">
  <header class="page-head">
    <h1>About</h1>
  </header>

  <div class="about-grid">
    <div>
      <div class="about-intro">
        <Image class="avatar" src={avatar} alt={`Photo of ${SITE.name}`} width="192" height="192" densities={[1, 2]} />
        <div>
          <p class="about-summary">{ROLE.summary} {SITE.location}.</p>
          <p>{ROLE.intro}</p>
          <div class="btn-row">
            {SITE.cv && <a class="btn btn--primary" href={SITE.cv} download>Download CV</a>}
            <a class={`btn ${SITE.cv ? '' : 'btn--primary'}`} href={SITE.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
            <a class="btn" href="/contact/">Get in touch</a>
          </div>
        </div>
      </div>

      <section class="section">
        <div class="section-head"><h2>Experience</h2></div>
        <ol class="timeline">
          {experience.map((t) => (
            <li>
              <span class="when">{t.when}</span>
              <h3>{t.title}{t.org && <span class="org">, {t.org}</span>}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <div class="section-head"><h2>Education</h2></div>
        <ol class="timeline">
          {education.map((t) => (
            <li>
              <span class="when">{t.when}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <div class="section-head"><h2>Selected work</h2></div>
        <ul class="worklist">
          {work.map((w) => (
            <li><p>{w.text}</p><a href={w.href}>{w.label}</a></li>
          ))}
        </ul>
      </section>

      <Contributions />
    </div>

    <aside>
      <section class="section section--first">
        <div class="section-head"><h2>Skills</h2></div>
        <dl class="skills">
          {skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>
    </aside>
  </div>
</Base>
