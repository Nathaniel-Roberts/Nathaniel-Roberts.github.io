---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, ROLE, STARTED_NEXT } from '../site';
import avatar from '../assets/avatar.jpg';
import Contributions from '../components/Contributions.astro';

const description = STARTED_NEXT
  ? 'Cybersecurity Incident Response Analyst at PepsiCo with a systems engineering background.'
  : 'Systems engineer with a cybersecurity degree, moving into incident response at PepsiCo in October 2026.';

const experience = [
  {
    when: STARTED_NEXT ? 'Oct 2026 to now' : 'From Oct 2026',
    title: 'Cyber Security Incident Response Analyst',
    org: 'PepsiCo',
    body: 'Incident detection, triage, investigation, containment and recovery in the Cyber Fusion Center, across a global enterprise environment.',
  },
  {
    when: STARTED_NEXT ? 'Jun 2023 to Oct 2026' : 'Jun 2023 to now',
    title: 'Systems Engineer',
    org: 'Melos Education',
    body: 'Design, delivery and security of the network and platforms for a group of ten schools (about 1500 students, 250 staff and 2000 devices): Juniper Mist, Palo Alto, Cloudflare Zero Trust, Okta and Entra ID, Sentinel and QRadar, all being brought under Terraform. Started part-time as Junior Systems Engineer, full-time Systems Engineer from November 2024.',
  },
  {
    when: 'Feb to Jun 2024',
    title: 'Ethical Hacker, university placement',
    org: 'Setup International (WebSchool.au)',
    body: 'Penetration testing of a live client stack from web front end through APIs to the database, with findings presented to and adopted by the client.',
  },
  {
    when: 'Aug 2022 to Jun 2023',
    title: 'Service Delivery Officer',
    org: 'Melos Education',
    body: 'First point of contact for technical support across school sites: triage, onsite troubleshooting and the internal knowledge base.',
  },
  {
    when: '2019 to 2023',
    title: 'Front End Team Supervisor',
    org: 'Woolworths',
    body: 'Supervised a team of 15 or more in a high-volume store, alongside study.',
  },
];

const education = [
  { when: '2022 to 2024', title: 'Bachelor of Cyber Security, Macquarie University', body: 'Threat detection and response, digital forensics, penetration testing, privacy and risk assessment, and red, blue and purple team exercises.' },
];

const work = [
  { text: 'Contained a critical CVSS 9.8 vulnerability in the core school information system before it was exploited: isolated it behind the Cloudflare WAF, timed the outage for the end of the school day, validated the vendor patch, restored service, then wrote the incident response process the organisation had been missing.', href: null, label: '' },
  { text: 'Delivered the first Juniper Mist deployment by an Australian education institution: wired and wireless across six sites, 57 switches and 160 or more access points, each from design documents through to as-built handoff. Built certificate-based network access control on top of it with 802.1X, EAP-TLS and SCEP through MDM.', href: null, label: '' },
  { text: 'Brought the firewalls, network, MDM and identity platform under Terraform, with Ansible for Windows Server and Azure Arc, and put every change through a reviewed pull request after an early change took switches offline at several sites.', href: null, label: '' },
  { text: 'Deployed IBM QRadar on premises with a Cloudflare Logpush pipeline, and run alert investigation across Sentinel, QRadar, Defender and Jamf Protect, including a recurring macOS infostealer campaign handled end to end from detection to playbook.', href: null, label: '' },
  { text: 'Wrote the organisation-wide information security and acceptable use policies against the ASD Essential 8 and NIST CSF, and led cyber assessments of newly acquired schools with risk registers that drove prioritised remediation.', href: null, label: '' },
  { text: 'Penetration-tested a live client environment during the WebSchool.au placement and delivered the findings.', href: '/posts/webschoolau-internship/', label: 'Read the write-up' },
  { text: 'Wrote a full incident report on a healthcare ransomware attack assessed against the NIST Cybersecurity Framework, and a privacy impact assessment of the Fortinet breach against the GDPR and the Australian Privacy Principles.', href: '/projects/', label: 'Read the reports' },
  { text: 'Designed and built a segmented homelab: OPNsense firewall, a VLAN per device class, Terraform-managed configuration, monitoring, and backups tested by restoring them.', href: '/uses/', label: 'See the setup' },
];

const skills = [
  { group: 'Incident response and detection', items: ['Full incident lifecycle', 'Microsoft Sentinel', 'IBM QRadar', 'Microsoft Defender', 'Jamf Protect', 'Log and artefact analysis', 'Playbooks'] },
  { group: 'Networking and edge', items: ['Juniper Mist', 'Palo Alto NGFW', 'Fortinet', 'Ubiquiti UniFi', 'VLAN segmentation', '802.1X and EAP-TLS', 'Cloudflare Zero Trust'] },
  { group: 'Identity and endpoint', items: ['Okta', 'Entra ID and PIM', 'MFA and RBAC', 'Microsoft 365', 'Intune', 'Jamf'] },
  { group: 'Automation and code', items: ['Terraform', 'Ansible', 'Node-RED', 'Python', 'Node.js', 'PowerShell', 'Bash', 'AI-assisted engineering'] },
  { group: 'Cloud and platforms', items: ['Microsoft Azure', 'Azure Arc', 'Windows Server', 'Linux', 'Nutanix', 'Kubernetes', 'Proxmox'] },
  { group: 'Risk and frameworks', items: ['ASD Essential 8', 'NIST CSF', 'Risk registers', 'Privacy impact assessment', 'Microsoft Purview', 'Tenable and Nessus'] },
  { group: 'Offensive', items: ['Penetration testing', 'Kali Linux', 'SQLmap', 'XSStrike', 'Burp Suite', 'Nmap', 'CTF', 'Bug bounty'] },
];
---

<Base title="About" description={description} og="about">
  <header class="page-head">
    <h1>About</h1>
  </header>

  <div class="about-grid">
    <div>
      <div class="about-intro">
        <Image class="avatar" src={avatar} alt={`Photo of ${SITE.name}`} width="192" height="192" densities={[1, 2]} />
        <div>
          <p class="about-summary">{ROLE.summary} {SITE.location}.</p>
          <p>{ROLE.intro}</p>
          <div class="btn-row">
            {SITE.cv && <a class="btn btn--primary" href={SITE.cv} download>Download CV</a>}
            <a class={`btn ${SITE.cv ? '' : 'btn--primary'}`} href={SITE.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
            <a class="btn" href="/contact/">Get in touch</a>
          </div>
        </div>
      </div>

      <section class="section">
        <div class="section-head"><h2>Experience</h2></div>
        <ol class="timeline">
          {experience.map((t) => (
            <li>
              <span class="when">{t.when}</span>
              <h3>{t.title}{t.org && <span class="org">, {t.org}</span>}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <div class="section-head"><h2>Education</h2></div>
        <ol class="timeline">
          {education.map((t) => (
            <li>
              <span class="when">{t.when}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <div class="section-head"><h2>Selected work</h2></div>
        <ul class="worklist">
          {work.map((w) => (
            <li><p>{w.text}</p>{w.href && <a href={w.href}>{w.label}</a>}</li>
          ))}
        </ul>
      </section>

      <Contributions />
    </div>

    <aside>
      <section class="section section--first">
        <div class="section-head"><h2>Skills</h2></div>
        <dl class="skills">
          {skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))}
        </dl>
      </section>
    </aside>
  </div>
</Base>
