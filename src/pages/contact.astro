---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
const description = 'Questions, project ideas or collaborations. Use the form, or email, GitHub and LinkedIn.';
---

<Base title="Contact" description={description} og="contact">
  <header class="page-head">
    <h1>Contact</h1>
    <p class="lede">{description}</p>
  </header>

  <div class="contact-grid">
    <form class="cform" data-contact-form novalidate>
      <label>
        <span>Name</span>
        <input type="text" name="name" id="contact-name" required minlength="2" maxlength="100" autocomplete="name" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" id="contact-email" required maxlength="200" autocomplete="email" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" id="contact-message" required minlength="10" maxlength="5000" rows="7"></textarea>
      </label>
      <div class="hp" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="cf-turnstile" data-turnstile data-sitekey={SITE.turnstileSiteKey}></div>
      <div class="cform-actions">
        <button class="btn btn--primary" type="submit" data-submit>Send message</button>
        <p class="cform-status" data-status role="status" aria-live="polite"></p>
      </div>
    </form>
    <div class="cform-done" data-done hidden role="status" aria-live="polite">
      <p class="cform-done-title"><span class="tick" aria-hidden="true">✓</span> Message sent</p>
      <p>Thanks, <span data-done-name></span>. It has landed in my inbox and I will reply to <span class="mono" data-done-email></span>.</p>
      <button class="btn" type="button" data-done-again>Send another</button>
    </div>

    <ul class="contact-list">
      <li>
        <span class="k">Email</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <button class="copy" type="button" data-copy={SITE.email} aria-label="Copy email address">copy</button>
      </li>
      <li>
        <span class="k">GitHub</span>
        <a href={SITE.github} target="_blank" rel="noopener me">github.com/Nathaniel-Roberts</a>
      </li>
      <li>
        <span class="k">LinkedIn</span>
        <a href={SITE.linkedin} target="_blank" rel="noopener me">linkedin.com/in/nathaniel-g-roberts</a>
      </li>
      <li>
        <span class="k">Security</span>
        <a href="/.well-known/security.txt">Found something? Read security.txt</a>
      </li>
    </ul>
  </div>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
  let widgetId: string | null = null;

  function renderTurnstile(attempt = 0) {
    const host = document.querySelector<HTMLElement>('[data-turnstile]');
    const ts = (window as any).turnstile;
    if (!host) return;
    if (!ts) { if (attempt < 50) setTimeout(() => renderTurnstile(attempt + 1), 100); return; }
    if (host.dataset.rendered) return;
    host.dataset.rendered = '1';
    widgetId = ts.render(host, { sitekey: host.dataset.sitekey, theme: document.documentElement.dataset.scheme === 'dark' ? 'dark' : 'light', appearance: 'always' });
  }

  async function submit(form: HTMLFormElement) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const ts = (window as any).turnstile;
    const data = Object.fromEntries(new FormData(form).entries());
    const token = widgetId && ts ? ts.getResponse(widgetId) : '';
    if (!form.reportValidity()) return;
    if (!token) { status.textContent = 'Please complete the verification first.'; return; }
    btn.disabled = true;
    status.classList.remove('is-error');
    status.textContent = 'Sending...';
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...data, token }) });
      const out = await res.json().catch(() => ({}));
      if (res.ok && out.ok) {
        status.textContent = '';
        const done = document.querySelector<HTMLElement>('[data-done]')!;
        done.querySelector('[data-done-name]')!.textContent = String(data.name || '').trim().split(/\s+/)[0] || 'there';
        done.querySelector('[data-done-email]')!.textContent = String(data.email || '');
        form.hidden = true;
        done.hidden = false;
        done.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        form.reset();
      } else {
        status.textContent = out.error || 'Something went wrong. Email me directly instead.';
        status.classList.add('is-error');
      }
    } catch {
      status.textContent = 'Network error. Email me directly instead.';
    } finally {
      btn.disabled = false;
      if (widgetId && ts) ts.reset(widgetId);
    }
  }

  // Bind on the form itself so this runs before Astro's client router sees the
  // submit event; the router skips forms whose submit was already prevented.
  function bindForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', (e) => { e.preventDefault(); e.stopPropagation(); void submit(form); });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-done-again]')) return;
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const done = document.querySelector<HTMLElement>('[data-done]');
    if (form && done) { done.hidden = true; form.hidden = false; form.querySelector<HTMLInputElement>('input[name=name]')?.focus(); }
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!btn) return;
    try { await navigator.clipboard.writeText(btn.dataset.copy!); btn.textContent = 'copied'; } catch { btn.textContent = 'failed'; }
    setTimeout(() => (btn.textContent = 'copy'), 1500);
  });

  document.addEventListener('astro:page-load', () => { widgetId = null; bindForm(); renderTurnstile(); });
</script>
