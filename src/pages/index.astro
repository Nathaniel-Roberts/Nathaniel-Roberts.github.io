---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Card from '../components/Card.astro';
import Contributions from '../components/Contributions.astro';
import { BUILD } from '../lib/build';
import { SITE, ROLE } from '../site';
import avatar from '../assets/avatar.jpg';

const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) => b.data.date.valueOf() - a.data.date.valueOf();
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDate);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byDate).slice(0, 2);
const withTime = async <T extends { id: string }>(items: T[]) =>
  Promise.all(items.map(async (e) => ({ entry: e, minutes: (await render(e as any)).remarkPluginFrontmatter.minutesRead as number })));
const featuredT = await withTime(featured);
const postsT = await withTime(posts);
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const termInfo = { build: BUILD.short, posts: String(allPosts.length), projects: String(projects.length), astro: '7' };
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Person', name: SITE.name, url: SITE.url, jobTitle: ROLE.title, worksFor: ROLE.org ? { '@type': 'Organization', name: ROLE.org } : undefined, sameAs: [SITE.github, SITE.linkedin], email: SITE.email, image: new URL('/images/avatar.jpg', SITE.url).toString() },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, description: SITE.description, inLanguage: 'en-AU' },
];

const lines = [
  { cmd: 'whoami', slot: 'whoami' },
  { cmd: 'cat role.txt', out: SITE.tagline },
  { cmd: 'ls ~/projects', links: featured.map((p) => ({ label: p.id, href: `/projects/${p.id}/` })) },
];
---

<Base jsonld={jsonld}>
  <section class="hero-center" aria-label="Introduction">
    <Image class="avatar" src={avatar} alt={`Photo of ${SITE.name}`} width="288" height="288" densities={[1, 2]} loading="eager" />
    <h1>{SITE.name}</h1>
    <p class="hero-tagline">{SITE.tagline}</p>
    <p class="hero-role">{ROLE.summary} {SITE.location}.</p>
    <ul class="icon-row" aria-label="Profiles and contact">
      <li><a href={SITE.github} target="_blank" rel="noopener me" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg></a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noopener me" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5v-9h3v9ZM6.5 8.3A1.8 1.8 0 1 1 6.5 4.7a1.8 1.8 0 0 1 0 3.6ZM19 19h-3v-4.7c0-1.4-.5-2.1-1.6-2.1-1.2 0-1.9.8-1.9 2.1V19h-3v-9h2.9v1.3a3.4 3.4 0 0 1 3-1.6c2.1 0 3.6 1.3 3.6 4V19Z"/></svg></a></li>
      <li><a href={`mailto:${SITE.email}`} aria-label="Email" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a></li>
    </ul>
    <p class="hero-links">
      {SITE.cv && <a href={SITE.cv} download>Download CV</a>}
      <a href="/about/">About me</a>
    </p>
    <a class="hero-more" href="#work" data-hero-more>Work and writing below</a>
  </section>

  <div id="work">
    <section class="section">
      <div class="section-head">
        <h2>Featured projects</h2>
        <a href="/projects/">all projects</a>
      </div>
      <ol class="index">
        {featuredT.map(({ entry, minutes }) => (
          <Card compact href={`/projects/${entry.id}/`} title={entry.data.title} description={entry.data.description} date={entry.data.date} type={entry.data.type} tags={entry.data.tags} minutes={minutes} />
        ))}
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Latest blog posts</h2>
        <a href="/posts/">all posts</a>
      </div>
      <ol class="index">
        {postsT.map(({ entry, minutes }) => (
          <Card compact href={`/posts/${entry.id}/`} title={entry.data.title} description={entry.data.description} date={entry.data.date} tags={entry.data.tags} minutes={minutes} />
        ))}
      </ol>
    </section>

    <Contributions />
  </div>

  <p class="term-toggle"><button type="button" class="linkish" data-term-open aria-expanded="false" aria-controls="terminal">Open terminal</button></p>
  <section class="term-drawer" id="terminal" data-term-drawer hidden aria-label="Interactive terminal">
    <Terminal lines={lines} info={termInfo}>
      <div slot="whoami" class="t-who">
        <Image class="avatar" src={avatar} alt="" width="112" height="112" densities={[1, 2]} />
        <h2 class="t-name">{SITE.name}</h2>
      </div>
    </Terminal>
    <p class="term-toggle"><button type="button" class="linkish" data-term-close>Hide terminal</button></p>
  </section>
</Base>

<script>
  // Dynamic hero: full-screen and centred at the top of the page, collapsed to its
  // content once the reader scrolls, expanded again when they return to the top.
  let compact = false;
  let lock = 0;
  const hero = () => document.querySelector<HTMLElement>('.hero-center');

  function gapEstimate(h: HTMLElement) {
    const kids = [...h.children].filter((c) => !c.hasAttribute('data-hero-more')) as HTMLElement[];
    const top = kids[0]?.getBoundingClientRect().top ?? 0;
    const bottom = kids[kids.length - 1]?.getBoundingClientRect().bottom ?? 0;
    return h.getBoundingClientRect().height - (bottom - top) - 96;
  }
  function setCompact(h: HTMLElement, on: boolean) {
    compact = on;
    h.classList.toggle('is-compact', on);
    lock = Date.now();
  }
  function onScroll() {
    const h = hero();
    if (!h) return;
    const y = window.scrollY;
    if (!compact && y > 40) {
      // Shrink by the empty space, but never so much that the page stops being
      // scrollable (the browser would clamp to the top and the hero would bounce).
      const gap = gapEstimate(h);
      const spare = document.documentElement.scrollHeight - innerHeight - 120;
      const shrink = Math.min(gap, spare);
      if (shrink > 40) {
        h.style.setProperty('--hero-compact-min', `${Math.round(h.getBoundingClientRect().height - shrink)}px`);
        setCompact(h, true);
      }
    } else if (compact && y <= 2 && Date.now() - lock > 500) {
      setCompact(h, false);
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-hero-more]');
    const h = hero();
    if (!a || !h) return;
    e.preventDefault();
    const target = document.getElementById('work');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!compact && !reduce) {
      setCompact(h, true);
      window.setTimeout(() => target?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 480);
    } else {
      target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  });
  document.addEventListener('astro:page-load', () => {
    const h = hero();
    if (!h) return;
    compact = false;
    h.classList.remove('is-compact');
    if (window.scrollY > 40) onScroll();
  });

  function setOpen(open: boolean) {
    const drawer = document.querySelector<HTMLElement>('[data-term-drawer]');
    const btn = document.querySelector<HTMLElement>('[data-term-open]');
    if (!drawer || !btn) return;
    drawer.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Terminal is open below' : 'Open terminal';
    if (open) {
      document.dispatchEvent(new CustomEvent('term:open'));
      drawer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-term-open]')) setOpen(true);
    else if (t.closest('[data-term-close]')) setOpen(false);
  });
  document.addEventListener('term:toggle', () => {
    const drawer = document.querySelector<HTMLElement>('[data-term-drawer]');
    if (drawer) setOpen(Boolean(drawer.hidden));
  });
</script>
