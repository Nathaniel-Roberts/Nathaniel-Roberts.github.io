---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const items = await getCollection('posts', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const others = (await getCollection('posts', ({ data, id }) => !data.draft && id !== entry.id));
const related = others
  .map((o) => ({ o, score: o.data.tags.filter((t) => entry.data.tags.includes(t)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.o.data.date.valueOf() - a.o.data.date.valueOf())
  .slice(0, 3)
  .map(({ o }) => ({ href: `/posts/${o.id}/`, title: o.data.title, description: o.data.description, date: o.data.date, type: 'type' in o.data ? (o.data as any).type : undefined, tags: o.data.tags }));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  minutes={remarkPluginFrontmatter.minutesRead}
  words={remarkPluginFrontmatter.words}
  headings={headings}
  og={`posts/${entry.id}`}
  comments
  back={{ href: '/posts/', label: 'posts' }}
  sourcePath={`src/content/posts/${entry.id}.md`}
  related={related}
>
  <Content />
</Article>
