---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const items = await getCollection('projects', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  type={entry.data.type}
  minutes={remarkPluginFrontmatter.minutesRead}
  words={remarkPluginFrontmatter.words}
  headings={headings}
  og={`projects/${entry.id}`}
  back={{ href: '/projects/', label: 'projects' }}
  sourcePath={`src/content/projects/${entry.id}.md`}
>
  <Content />
</Article>
