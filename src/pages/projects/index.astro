---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import TagFilter from '../../components/TagFilter.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const items = await Promise.all(projects.map(async (p) => ({ p, minutes: (await render(p)).remarkPluginFrontmatter.minutesRead as number })));
const types = [...new Set(projects.map((p) => p.data.type.toLowerCase()))];
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const description = 'Penetration test reports, incident analyses, privacy assessments and data work. Written up in full, with the reasoning shown.';
---

<Base title="Projects" description={description} og="projects">
  <header class="page-head">
    <p class="eyebrow">~/projects</p>
    <h1>Projects</h1>
    <p class="lede">{description}</p>
  </header>
  <div>
    <TagFilter tags={[...new Set([...types, ...tags])]} noun="projects" />
    <ol class="index" data-filter-target>
      {items.map(({ p, minutes }) => (
        <Card href={`/projects/${p.id}/`} title={p.data.title} description={p.data.description} date={p.data.date} type={p.data.type} tags={p.data.tags} minutes={minutes} />
      ))}
    </ol>
    <p class="empty" data-empty hidden>Nothing matches that tag.</p>
  </div>
</Base>
